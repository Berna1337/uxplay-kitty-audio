[Desktop Entry]
Type=Application
Name=Uka
GenericName=AirPlay Audio Visualizer
Comment=Kitty-native AirPlay audio visualizer powered by UxPlay
TryExec=kitty
Exec=kitty --class uxplay-kitty-audio --title "Uka" uxplay-kitty-audio
Icon=uxplay-kitty-audio
Terminal=false
Categories=AudioVideo;Audio;
Keywords=AirPlay;audio;music;receiver;visualizer;
StartupWMClass=uxplay-kitty-audio
StartupNotify=true
