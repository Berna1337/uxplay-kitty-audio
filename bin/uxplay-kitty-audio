#!/usr/bin/env bash

set -u

APP_NAME="uxplay-kitty-audio"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$APP_NAME"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_NAME"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"
ART_FILE="$CACHE_DIR/cover.jpg"
META_FILE="$CACHE_DIR/metadata.txt"
LOG_FILE="$CACHE_DIR/uxplay.log"
STATE_FILE="$CACHE_DIR/playback.state"
UXPLAY_FIFO="$CACHE_DIR/uxplay-output.fifo"
CAVA_CONFIG="$CACHE_DIR/cava.conf"
CAVA_FIFO="$CACHE_DIR/cava.fifo"
DISCORD_FIFO="$CACHE_DIR/discord.fifo"
DISCORD_LOG_FILE="$CACHE_DIR/discord-rpc.log"
DISCORD_ART_CACHE="$CACHE_DIR/discord-art-cache.json"

DISCORD_CLIENT_ID="1542699590959104081"
DISCORD_ASSET_KEY="uxplay-kitty-audio"
DISCORD_GENERIC_ASSET_KEY="uxplay-kitty-audio-sound"
DISCORD_RECONNECT_INTERVAL=5

VISUALIZER_FPS=60
QUALITY_INTERVAL_MS=500
FILE_CHECK_INTERVAL_MS=100

ART_COL=4
ART_ROW=6
ART_WIDTH=36
ART_HEIGHT=18
INFO_COL=45
INFO_ROW=6
PROGRESS_ROW=25
VISUALIZER_ROW=28
VISUALIZER_HEIGHT=7
VISUALIZER_GAIN=150
CAVA_MAX_RANGE=100

ACCENT_INDEX=141
ACCENT_BRIGHT_INDEX=177
PURPLE="\033[38;5;${ACCENT_INDEX}m"
PURPLE_BRIGHT="\033[38;5;${ACCENT_BRIGHT_INDEX}m"
WHITE='\033[97m'
GREY='\033[38;5;245m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

UXPLAY_PID=""
PLAYBACK_PID=""
CAVA_PID=""
DISCORD_PID=""
DISCORD_FD_OPEN=0
DISCORD_ENABLED=1
MENU_OPEN=0
TERMINAL_STATE=""

CACHED_TITLE=""
CACHED_ARTIST=""
CACHED_ALBUM=""
CACHED_GENRE=""
CACHED_DEVICE=""
CACHED_POSITION=0
CACHED_DURATION=0
CACHED_PLAYBACK_KIND="pending"
CACHED_STATE_GENERATION=0
CACHED_TIMELINE_REVISION=0

CACHED_STREAM_CODEC="—"
CACHED_STREAM_RATE=0
CACHED_STREAM_BITS=0
CACHED_STREAM_CHANNELS=0

LAST_ART_SIGNATURE=""
LAST_STATE_SIGNATURE=""
LAST_RENDERED_QUALITY=""
LAST_RENDERED_TITLE=""
LAST_RENDERED_ARTIST=""
LAST_RENDERED_ALBUM=""
LAST_RENDERED_GENRE=""
LAST_RENDERED_DEVICE=""
LAST_RENDERED_PROGRESS_CURRENT=-1
LAST_RENDERED_PROGRESS_DURATION=-1
LAST_DISCORD_SIGNATURE=""

if [[ -f "$SETTINGS_FILE" ]]; then
    while IFS='=' read -r setting value; do
        if [[ "$setting" == "discord" && "$value" == "off" ]]; then
            DISCORD_ENABLED=0
        fi
    done < "$SETTINGS_FILE"
fi

if command -v kitten >/dev/null 2>&1; then
    KITTEN_BIN="$(command -v kitten)"
elif [[ -x "$HOME/.local/kitty.app/bin/kitten" ]]; then
    KITTEN_BIN="$HOME/.local/kitty.app/bin/kitten"
else
    printf '%s\n' \
        "Uka requires Kitty and its kitten helper." \
        "Install Kitty, then launch Uka with: uxplay-kitty-audio" \
        "https://sw.kovidgoyal.net/kitty/" >&2
    exit 1
fi

if [[ -z "${KITTY_WINDOW_ID:-}" && "${TERM:-}" != "xterm-kitty" ]]; then
    printf '%s\n' \
        "Uka is a Kitty-native application." \
        "Please launch it from a Kitty terminal." \
        "https://sw.kovidgoyal.net/kitty/" >&2
    exit 1
fi

REQUIRED_COMMANDS=(uxplay cava magick pactl iconv python3)
MISSING_COMMANDS=()

for required_command in "${REQUIRED_COMMANDS[@]}"; do
    command -v "$required_command" >/dev/null 2>&1 \
        || MISSING_COMMANDS+=("$required_command")
done

if (( ${#MISSING_COMMANDS[@]} > 0 )); then
    printf 'Uka is missing required commands: %s\n' \
        "${MISSING_COMMANDS[*]}" >&2
    printf '%s\n' \
        "Install the complete dependency set before launching Uka." >&2
    exit 1
fi

DEFAULT_SINK="$(pactl get-default-sink 2>/dev/null || true)"
if [[ -z "$DEFAULT_SINK" ]]; then
    printf '%s\n' \
        "Uka could not determine the default audio sink." \
        "Make sure your PulseAudio-compatible audio service is running." >&2
    exit 1
fi
CAVA_SOURCE="${DEFAULT_SINK}.monitor"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/../lib/discord-rpc.py" ]]; then
    DISCORD_HELPER="$SCRIPT_DIR/../lib/discord-rpc.py"
else
    DISCORD_HELPER="${XDG_DATA_HOME:-$HOME/.local/share}/uxplay-kitty-audio/discord-rpc.py"
fi

if [[ ! -f "$DISCORD_HELPER" ]]; then
    printf 'Uka could not find its Discord RPC helper: %s\n' \
        "$DISCORD_HELPER" >&2
    exit 1
fi

mkdir -p "$CACHE_DIR"
rm -f \
    "$ART_FILE" \
    "$META_FILE" \
    "$LOG_FILE" \
    "$CAVA_FIFO" \
    "$DISCORD_FIFO" \
    "$DISCORD_LOG_FILE"
mkfifo "$CAVA_FIFO" "$DISCORD_FIFO"

save_settings() {
    mkdir -p "$CONFIG_DIR"
    if (( DISCORD_ENABLED )); then
        printf '%s\n' 'discord=on' > "$SETTINGS_FILE"
    else
        printf '%s\n' 'discord=off' > "$SETTINGS_FILE"
    fi
}

start_discord_helper() {
    (( DISCORD_ENABLED )) || return
    if [[ -n "$DISCORD_PID" ]] && kill -0 "$DISCORD_PID" 2>/dev/null; then
        return
    fi

    exec 4<>"$DISCORD_FIFO"
    DISCORD_FD_OPEN=1
    python3 "$DISCORD_HELPER" \
        --client-id "$DISCORD_CLIENT_ID" \
        --asset-key "$DISCORD_ASSET_KEY" \
        --generic-asset-key "$DISCORD_GENERIC_ASSET_KEY" \
        --reconnect-interval "$DISCORD_RECONNECT_INTERVAL" \
        --art-cache "$DISCORD_ART_CACHE" \
        --pid "$$" \
        <"$DISCORD_FIFO" \
        4>&- \
        >/dev/null \
        2>>"$DISCORD_LOG_FILE" &
    DISCORD_PID=$!
    LAST_DISCORD_SIGNATURE=""
}

stop_discord_helper() {
    local was_running=0 attempt

    if (( DISCORD_FD_OPEN )); then
        was_running=1
        printf '\0\0\0\0\0' >&4 2>/dev/null || true
        exec 4>&-
        DISCORD_FD_OPEN=0
    fi

    if [[ -n "$DISCORD_PID" ]]; then
        was_running=1
        for ((attempt = 0; attempt < 20; attempt++)); do
            kill -0 "$DISCORD_PID" 2>/dev/null || break
            sleep 0.05
        done
        if kill -0 "$DISCORD_PID" 2>/dev/null; then
            kill "$DISCORD_PID" 2>/dev/null || true
        fi
        wait "$DISCORD_PID" 2>/dev/null || true
        DISCORD_PID=""
    fi

    if (( was_running )); then
        python3 "$DISCORD_HELPER" \
            --client-id "$DISCORD_CLIENT_ID" \
            --asset-key "$DISCORD_ASSET_KEY" \
            --pid "$$" \
            --clear \
            >/dev/null \
            2>>"$DISCORD_LOG_FILE" || true
    fi
    LAST_DISCORD_SIGNATURE=""
}

cleanup() {
    trap - EXIT INT TERM

    [[ -n "$UXPLAY_PID" ]] && kill "$UXPLAY_PID" 2>/dev/null || true
    [[ -n "$PLAYBACK_PID" ]] && kill "$PLAYBACK_PID" 2>/dev/null || true
    [[ -n "$CAVA_PID" ]] && kill "$CAVA_PID" 2>/dev/null || true

    stop_discord_helper

    if [[ -n "$TERMINAL_STATE" ]]; then
        stty "$TERMINAL_STATE" 2>/dev/null || true
        TERMINAL_STATE=""
    fi

    "$KITTEN_BIN" icat --clear 2>/dev/null || true

    printf '\033[?25h'
    printf '\033[0m'
    rm -f "$CAVA_FIFO" "$DISCORD_FIFO"
    clear
}

trap cleanup EXIT INT TERM

move_to() { printf '\033[%s;%sH' "$1" "$2"; }
clear_line() { printf '\033[2K'; }
terminal_width() { tput cols; }
terminal_height() { tput lines; }
hide_cursor() { printf '\033[?25l'; }
get_time_ms() { date +%s%3N; }

print_centered() {
    local row="$1" text="$2" plain_text cols start
    cols="$(terminal_width)"
    plain_text="$(printf '%b' "$text" | sed $'s/\033\\[[0-9;]*m//g')"
    start=$(((cols - ${#plain_text}) / 2))
    (( start < 1 )) && start=1
    move_to "$row" 1
    clear_line
    move_to "$row" "$start"
    printf '%b' "$text"
}

get_file_signature() {
    local file="$1"
    [[ -f "$file" ]] && stat -c '%i:%y:%s' "$file" 2>/dev/null || true
}

update_playback_state_cache() {
    [[ -s "$STATE_FILE" ]] || return 1

    local title artist album genre position duration playback_kind
    local generation timeline_revision

    # Read the entire NUL-delimited snapshot before changing any cached
    # value. The producer publishes with an atomic rename, so the TUI and
    # Discord always observe one complete content generation.
    exec 5<"$STATE_FILE"
    IFS= read -r -d '' title <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' artist <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' album <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' genre <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' position <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' duration <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' playback_kind <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' generation <&5 || { exec 5<&-; return 1; }
    IFS= read -r -d '' timeline_revision <&5 || { exec 5<&-; return 1; }
    exec 5<&-

    [[ "$position" =~ ^[0-9]+$ ]] || return 1
    [[ "$duration" =~ ^[0-9]+$ ]] || return 1
    [[ "$generation" =~ ^[0-9]+$ ]] || return 1
    [[ "$timeline_revision" =~ ^[0-9]+$ ]] || return 1
    case "$playback_kind" in
        pending|track|live) ;;
        *) return 1 ;;
    esac

    if [[ "$generation" != "$CACHED_STATE_GENERATION" ]]; then
        LAST_DISCORD_SIGNATURE=""
    fi

    CACHED_TITLE="$title"
    CACHED_ARTIST="$artist"
    CACHED_ALBUM="$album"
    CACHED_GENRE="$genre"
    CACHED_POSITION="$position"
    CACHED_DURATION="$duration"
    CACHED_PLAYBACK_KIND="$playback_kind"
    CACHED_STATE_GENERATION="$generation"
    CACHED_TIMELINE_REVISION="$timeline_revision"
}

update_device_cache() {
    [[ -s "$LOG_FILE" ]] || return
    local line device
    local device_regex='connection request from ([^ ]+)'

    line="$(
        tail -n 2000 "$LOG_FILE" 2>/dev/null \
            | grep -a 'connection request from ' \
            | tail -n 1
    )"
    [[ -n "$line" ]] || return

    if [[ "$line" =~ $device_regex ]]; then
        device="${BASH_REMATCH[1]}"
        [[ -n "$device" ]] && CACHED_DEVICE="$device"
    fi
}

update_stream_format_cache() {
    [[ -s "$LOG_FILE" ]] || return
    local line codec rate bits channels

    line="$(
        tail -n 3000 "$LOG_FILE" 2>/dev/null \
            | grep -E 'format[[:space:]]+(ALAC|AAC-ELD|AAC|LPCM|PCM)[[:space:]]+[0-9]+(/[0-9]+)?/[0-9]+' \
            | tail -n 1
    )"
    [[ -n "$line" ]] || return

    if [[ "$line" =~ format[[:space:]]+(ALAC|AAC-ELD|AAC|LPCM|PCM)[[:space:]]+([0-9]+)/([0-9]+)/([0-9]+) ]]; then
        codec="${BASH_REMATCH[1]}"
        rate="${BASH_REMATCH[2]}"
        bits="${BASH_REMATCH[3]}"
        channels="${BASH_REMATCH[4]}"

        if [[ "$rate" =~ ^[0-9]+$ && "$bits" =~ ^[0-9]+$ && "$channels" =~ ^[0-9]+$ ]]; then
            CACHED_STREAM_CODEC="$codec"
            CACHED_STREAM_RATE="$rate"
            CACHED_STREAM_BITS="$bits"
            CACHED_STREAM_CHANNELS="$channels"
        fi
        return
    fi

    if [[ "$line" =~ format[[:space:]]+(ALAC|AAC-ELD|AAC|LPCM|PCM)[[:space:]]+([0-9]+)/([0-9]+) ]]; then
        codec="${BASH_REMATCH[1]}"
        rate="${BASH_REMATCH[2]}"
        channels="${BASH_REMATCH[3]}"

        if [[ "$rate" =~ ^[0-9]+$ && "$channels" =~ ^[0-9]+$ ]]; then
            CACHED_STREAM_CODEC="$codec"
            CACHED_STREAM_RATE="$rate"
            CACHED_STREAM_BITS=0
            CACHED_STREAM_CHANNELS="$channels"
        fi
    fi
}

format_sample_rate() {
    case "$1" in
        32000) printf '32 kHz' ;;
        44100) printf '44.1 kHz' ;;
        48000) printf '48 kHz' ;;
        88200) printf '88.2 kHz' ;;
        96000) printf '96 kHz' ;;
        176400) printf '176.4 kHz' ;;
        192000) printf '192 kHz' ;;
        0|"") printf '—' ;;
        *) printf '%s Hz' "$1" ;;
    esac
}

format_bit_depth() {
    local bits="$1"
    [[ "$bits" =~ ^[0-9]+$ ]] && (( bits > 0 )) && printf '%s-bit' "$bits"
}

format_channels() {
    case "$1" in
        1) printf 'Mono' ;;
        2) printf 'Stereo' ;;
        6) printf '5.1' ;;
        8) printf '7.1' ;;
        0|"") printf '' ;;
        *) printf '%s ch' "$1" ;;
    esac
}

get_stream_quality() {
    local rate_text bit_text channel_text quality
    rate_text="$(format_sample_rate "$CACHED_STREAM_RATE")"
    bit_text="$(format_bit_depth "$CACHED_STREAM_BITS")"
    channel_text="$(format_channels "$CACHED_STREAM_CHANNELS")"

    quality="$rate_text"
    [[ -n "$bit_text" ]] && quality+=" • $bit_text"
    [[ "$CACHED_STREAM_CODEC" != "—" ]] && quality+=" • $CACHED_STREAM_CODEC"
    [[ -n "$channel_text" ]] && quality+=" • $channel_text"
    printf '%s' "$quality"
}

get_duration_seconds() {
    printf '%s' "$CACHED_DURATION"
}

get_position_seconds() {
    printf '%s' "$CACHED_POSITION"
}

rgb_to_ansi256() {
    local r="$1" g="$2" b="$3"
    local ri gi bi
    ri=$((r * 5 / 255))
    gi=$((g * 5 / 255))
    bi=$((b * 5 / 255))
    printf '%d' $((16 + 36 * ri + 6 * gi + bi))
}

brighten_channel() {
    local value="$1"
    value=$((value + (255 - value) * 30 / 100))
    (( value > 255 )) && value=255
    printf '%d' "$value"
}

update_accent_from_artwork() {
    [[ -s "$ART_FILE" ]] || return

    local hex r g b bright_r bright_g bright_b accent bright_accent
    local max_channel scale

    # Give UxPlay a moment to finish writing the new cover, then choose a
    # saturated, visible color rather than simply the most common one.
    sleep 0.05
    hex="$(
        magick "$ART_FILE" \
            -alpha off \
            -resize 120x120 \
            -colors 24 \
            -format '%c' histogram:info: \
            2>/dev/null \
        | awk '
            function hex_digit(c) {
                c = tolower(c)
                return index("0123456789abcdef", c) - 1
            }
            function hex_byte(s) {
                return hex_digit(substr(s, 1, 1)) * 16 + hex_digit(substr(s, 2, 1))
            }
            match($0, /#[0-9A-Fa-f]{6}/) {
                hex = substr($0, RSTART + 1, 6)
                r = hex_byte(substr(hex, 1, 2))
                g = hex_byte(substr(hex, 3, 2))
                b = hex_byte(substr(hex, 5, 2))

                max = r
                if (g > max) max = g
                if (b > max) max = b
                min = r
                if (g < min) min = g
                if (b < min) min = b

                saturation = max - min
                brightness = (r + g + b) / 3
                score = saturation * 2 + brightness
                if (brightness < 30) score -= 200
                if (brightness > 235 && saturation < 20) score -= 100

                if (!found || score > best_score) {
                    found = 1
                    best_score = score
                    best_hex = hex
                }
            }
            END { if (found) print "#" best_hex }
        '
    )"

    if [[ ! "$hex" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        ACCENT_INDEX=141
        ACCENT_BRIGHT_INDEX=177
        PURPLE="\033[38;5;${ACCENT_INDEX}m"
        PURPLE_BRIGHT="\033[38;5;${ACCENT_BRIGHT_INDEX}m"
        return
    fi

    r=$((16#${hex:1:2}))
    g=$((16#${hex:3:2}))
    b=$((16#${hex:5:2}))

    max_channel="$r"
    (( g > max_channel )) && max_channel="$g"
    (( b > max_channel )) && max_channel="$b"
    if (( max_channel < 140 && max_channel > 0 )); then
        scale=$((140 * 100 / max_channel))
        r=$((r * scale / 100))
        g=$((g * scale / 100))
        b=$((b * scale / 100))
        (( r > 255 )) && r=255
        (( g > 255 )) && g=255
        (( b > 255 )) && b=255
    fi

    accent="$(rgb_to_ansi256 "$r" "$g" "$b")"
    bright_r="$(brighten_channel "$r")"
    bright_g="$(brighten_channel "$g")"
    bright_b="$(brighten_channel "$b")"
    bright_accent="$(rgb_to_ansi256 "$bright_r" "$bright_g" "$bright_b")"

    ACCENT_INDEX="$accent"
    ACCENT_BRIGHT_INDEX="$bright_accent"
    PURPLE="\033[38;5;${ACCENT_INDEX}m"
    PURPLE_BRIGHT="\033[38;5;${ACCENT_BRIGHT_INDEX}m"
}

draw_header() {
    local quality
    quality="$(get_stream_quality)"
    print_centered 1 "${PURPLE_BRIGHT}${BOLD}Uka${RESET}"
    print_centered 2 "${PURPLE}────────────────────────────────${RESET}"
    print_centered 3 "${GREY}${quality}${RESET}"
    LAST_RENDERED_QUALITY="$quality"
}

update_header_if_needed() {
    local quality
    quality="$(get_stream_quality)"
    [[ "$quality" != "$LAST_RENDERED_QUALITY" ]] && draw_header
}

draw_album_art() {
    "$KITTEN_BIN" icat --clear 2>/dev/null || true

    if [[ -s "$ART_FILE" ]]; then
        "$KITTEN_BIN" icat \
            --align left \
            --place "${ART_WIDTH}x${ART_HEIGHT}@${ART_COL}x${ART_ROW}" \
            "$ART_FILE" 2>/dev/null || true
        return
    fi

    move_to 13 7
    clear_line
    printf "${GREY}Waiting for artwork...${RESET}"
}

print_field() {
    local row="$1" label="$2" value="$3"
    move_to "$row" "$INFO_COL"
    clear_line
    printf "${PURPLE}${BOLD}%s${RESET}" "$label"
    move_to "$((row + 1))" "$INFO_COL"
    clear_line

    if [[ -n "$value" ]]; then
        printf "${WHITE}${BOLD}%s${RESET}" "$value"
    else
        printf "${GREY}—${RESET}"
    fi
}

draw_metadata() {
    print_field "$INFO_ROW" "TITLE" "$CACHED_TITLE"
    print_field "$((INFO_ROW + 4))" "ARTIST" "$CACHED_ARTIST"
    print_field "$((INFO_ROW + 8))" "ALBUM" "$CACHED_ALBUM"
    print_field "$((INFO_ROW + 12))" "GENRE" "$CACHED_GENRE"

    LAST_RENDERED_TITLE="$CACHED_TITLE"
    LAST_RENDERED_ARTIST="$CACHED_ARTIST"
    LAST_RENDERED_ALBUM="$CACHED_ALBUM"
    LAST_RENDERED_GENRE="$CACHED_GENRE"
}

draw_device() {
    move_to "$((INFO_ROW + 16))" "$INFO_COL"
    clear_line
    if [[ -n "$CACHED_DEVICE" ]]; then
        printf "${PURPLE}●${RESET} ${GREY}%s${RESET}" "$CACHED_DEVICE"
    else
        printf "${GREY}No AirPlay device connected${RESET}"
    fi
    LAST_RENDERED_DEVICE="$CACHED_DEVICE"
}

update_device_if_needed() {
    [[ "$CACHED_DEVICE" != "$LAST_RENDERED_DEVICE" ]] && draw_device
}

update_metadata_if_needed() {
    if [[ "$CACHED_TITLE" != "$LAST_RENDERED_TITLE" ||
          "$CACHED_ARTIST" != "$LAST_RENDERED_ARTIST" ||
          "$CACHED_ALBUM" != "$LAST_RENDERED_ALBUM" ||
          "$CACHED_GENRE" != "$LAST_RENDERED_GENRE" ]]; then
        draw_metadata
    fi
}

format_time() {
    local seconds="${1:-0}"
    [[ "$seconds" =~ ^[0-9]+$ ]] || seconds=0
    printf '%d:%02d' $((seconds / 60)) $((seconds % 60))
}

draw_progress_bar() {
    local current="$1" duration="$2"
    local cols track_width inner_width filled remaining start_col
    local current_text duration_text visible_width

    cols="$(terminal_width)"
    track_width=$((cols - 26))
    (( track_width > 64 )) && track_width=64
    (( track_width < 14 )) && return
    inner_width=$((track_width - 2))

    [[ "$current" =~ ^[0-9]+$ ]] || current=0
    [[ "$duration" =~ ^[0-9]+$ ]] || duration=0
    (( current < 0 )) && current=0

    move_to "$PROGRESS_ROW" 1
    clear_line

    if [[ "$CACHED_PLAYBACK_KIND" == "pending" ]]; then
        LAST_RENDERED_PROGRESS_CURRENT=-3
        LAST_RENDERED_PROGRESS_DURATION=-3
        return
    fi

    if [[ "$CACHED_PLAYBACK_KIND" == "live" ]]; then
        print_centered "$PROGRESS_ROW" "${PURPLE_BRIGHT}${BOLD}● LIVE${RESET}"
        LAST_RENDERED_PROGRESS_CURRENT=-2
        LAST_RENDERED_PROGRESS_DURATION=-2
        return
    fi

    if (( duration <= 0 )); then
        current_text="$(format_time "$current")"
        duration_text="--:--"
        visible_width=$((${#current_text} + 2 + track_width + 2 + ${#duration_text}))
        start_col=$(((cols - visible_width) / 2))
        (( start_col < 1 )) && start_col=1
        move_to "$PROGRESS_ROW" "$start_col"

        printf "${GREY}%s${RESET}  ${GREY}o${RESET}" "$current_text"
        printf "${DIM}${GREY}"
        printf '%*s' "$inner_width" '' | tr ' ' '-'
        printf "${RESET}${GREY}o${RESET}  ${GREY}%s${RESET}" "$duration_text"

        LAST_RENDERED_PROGRESS_CURRENT="$current"
        LAST_RENDERED_PROGRESS_DURATION="$duration"
        return
    fi

    (( current > duration )) && current="$duration"
    current_text="$(format_time "$current")"
    duration_text="$(format_time "$duration")"
    filled=$((current * (inner_width - 1) / duration))
    (( filled < 0 )) && filled=0
    (( filled > inner_width - 1 )) && filled=$((inner_width - 1))
    remaining=$((inner_width - filled - 1))
    visible_width=$((${#current_text} + 2 + track_width + 2 + ${#duration_text}))
    start_col=$(((cols - visible_width) / 2))
    (( start_col < 1 )) && start_col=1
    move_to "$PROGRESS_ROW" "$start_col"

    printf "${GREY}%s${RESET}  ${PURPLE_BRIGHT}o" "$current_text"
    (( filled > 0 )) && printf '%*s' "$filled" '' | tr ' ' '='
    printf 'O'
    printf "${RESET}${DIM}${GREY}"
    (( remaining > 0 )) && printf '%*s' "$remaining" '' | tr ' ' '-'
    printf "o${RESET}  ${GREY}%s${RESET}" "$duration_text"

    LAST_RENDERED_PROGRESS_CURRENT="$current"
    LAST_RENDERED_PROGRESS_DURATION="$duration"
}

update_progress_display() {
    local current duration

    if [[ "$CACHED_PLAYBACK_KIND" == "pending" ]]; then
        if (( LAST_RENDERED_PROGRESS_DURATION != -3 )); then
            draw_progress_bar 0 0
        fi
        return
    fi

    if [[ "$CACHED_PLAYBACK_KIND" == "live" ]]; then
        if (( LAST_RENDERED_PROGRESS_DURATION != -2 )); then
            draw_progress_bar 0 0
        fi
        return
    fi

    current="$(get_position_seconds)"
    duration="$(get_duration_seconds)"

    if (( current != LAST_RENDERED_PROGRESS_CURRENT || duration != LAST_RENDERED_PROGRESS_DURATION )); then
        draw_progress_bar "$current" "$duration"
    fi
}

update_discord_presence_if_needed() {
    (( DISCORD_FD_OPEN )) || return

    local current duration signature
    current="$(get_position_seconds)"
    duration="$(get_duration_seconds)"
    signature="${CACHED_TITLE}|${CACHED_ARTIST}|${CACHED_ALBUM}|${duration}|${CACHED_PROGRESS_START}|${CACHED_PROGRESS_END}"

    [[ "$signature" == "$LAST_DISCORD_SIGNATURE" ]] && return

    printf '%s\0%s\0%s\0%s\0%s\0' \
        "$CACHED_TITLE" \
        "$CACHED_ARTIST" \
        "$CACHED_ALBUM" \
        "$current" \
        "$duration" \
        >&4 2>/dev/null || true

    LAST_DISCORD_SIGNATURE="$signature"
}

draw_visualizer_frame() {
    local data="$1"
    local cols max_bars count bar_count spectrum_width spectrum_col
    local row index value scaled full_rows remainder line char
    local values

    cols="$(terminal_width)"
    max_bars=$(((cols - 8) / 2))
    (( max_bars > 64 )) && max_bars=64
    (( max_bars < 10 )) && return

    IFS=';' read -ra values <<< "$data"
    count=${#values[@]}
    (( count == 0 )) && return

    bar_count="$count"
    (( bar_count > max_bars )) && bar_count="$max_bars"

    spectrum_width=$((bar_count * 2))
    spectrum_col=$(((cols - spectrum_width) / 2))
    (( spectrum_col < 2 )) && spectrum_col=2

    for ((row = VISUALIZER_HEIGHT - 1; row >= 0; row--)); do
        line=""
        for ((index = 0; index < bar_count; index++)); do
            value="${values[$index]}"
            [[ "$value" =~ ^[0-9]+$ ]] || value=0
            scaled=$((value * VISUALIZER_HEIGHT * 8 * VISUALIZER_GAIN / (CAVA_MAX_RANGE * 100)))
            (( scaled < 0 )) && scaled=0
            (( scaled > VISUALIZER_HEIGHT * 8 )) && scaled=$((VISUALIZER_HEIGHT * 8))
            full_rows=$((scaled / 8))
            remainder=$((scaled % 8))
            char=" "

            if (( row < full_rows )); then
                char="█"
            elif (( row == full_rows && remainder > 0 )); then
                case "$remainder" in
                    1) char="▁" ;;
                    2) char="▂" ;;
                    3) char="▃" ;;
                    4) char="▄" ;;
                    5) char="▅" ;;
                    6) char="▆" ;;
                    7) char="▇" ;;
                esac
            fi
            line+="$char "
        done

        move_to "$((VISUALIZER_ROW + VISUALIZER_HEIGHT - 1 - row))" "$spectrum_col"
        printf "${PURPLE_BRIGHT}%s${RESET}" "$line"
    done
}

draw_visualizer_idle() {
    local row
    for ((row = 0; row < VISUALIZER_HEIGHT; row++)); do
        move_to "$((VISUALIZER_ROW + row))" 1
        clear_line
    done

    print_centered "$((VISUALIZER_ROW + 3))" "${GREY}Waiting for audio...${RESET}"
}

draw_footer() {
    print_centered "$(terminal_height)" "${GREY}Ctrl+C to quit${RESET}"
}

draw_settings_menu() {
    local status color
    if (( DISCORD_ENABLED )); then
        status="On"
        color="$PURPLE_BRIGHT"
    else
        status="Off"
        color="$GREY"
    fi

    clear
    print_centered 7 "${PURPLE_BRIGHT}${BOLD}Uka Settings${RESET}"
    print_centered 8 "${PURPLE}────────────────────────────────${RESET}"
    print_centered 12 "${WHITE}${BOLD}Discord Rich Presence${RESET}  ${color}[ ${status} ]${RESET}"
    print_centered 16 "${GREY}Enter or Space to toggle${RESET}"
    print_centered 17 "${GREY}M or Esc to close${RESET}"
}

close_settings_menu() {
    MENU_OPEN=0
    draw_screen
    draw_visualizer_idle
}

toggle_discord_setting() {
    if (( DISCORD_ENABLED )); then
        DISCORD_ENABLED=0
        stop_discord_helper
    else
        DISCORD_ENABLED=1
        start_discord_helper
        update_discord_presence_if_needed
    fi
    save_settings
    draw_settings_menu
}

handle_keyboard_input() {
    local key
    if ! IFS= read -rn1 -t 0.001 key; then
        return
    fi

    if (( MENU_OPEN )); then
        case "$key" in
            ""|" ") toggle_discord_setting ;;
            m|M|$'\e') close_settings_menu ;;
        esac
    elif [[ "$key" == "m" || "$key" == "M" ]]; then
        MENU_OPEN=1
        draw_settings_menu
    fi
}

draw_screen() {
    clear
    draw_header
    draw_album_art
    draw_metadata
    draw_device
    draw_progress_bar "$(get_position_seconds)" "$(get_duration_seconds)"
    draw_footer
}

python3 "$PLAYBACK_HELPER" \
    --input-fifo "$UXPLAY_FIFO" \
    --state-file "$STATE_FILE" \
    --log-file "$LOG_FILE" \
    </dev/null \
    >/dev/null \
    2>"$PLAYBACK_LOG_FILE" &

PLAYBACK_PID=$!

uxplay \
    -d \
    -async \
    -ca "$ART_FILE" \
    -md "$META_FILE" \
    </dev/null \
    >"$LOG_FILE" 2>&1 &

UXPLAY_PID=$!

start_discord_helper

cat > "$CAVA_CONFIG" <<EOF
[general]
bars = 48
framerate = ${VISUALIZER_FPS}

[input]
method = pulse
source = ${CAVA_SOURCE}

[output]
method = raw
raw_target = ${CAVA_FIFO}
data_format = ascii
ascii_max_range = ${CAVA_MAX_RANGE}
channels = mono

[smoothing]
noise_reduction = 40
EOF

cava -p "$CAVA_CONFIG" </dev/null >/dev/null 2>&1 &
CAVA_PID=$!

if [[ -t 0 ]]; then
    TERMINAL_STATE="$(stty -g)"
    stty -echo -icanon min 0 time 0
fi

hide_cursor
draw_screen
draw_visualizer_idle

exec 3<>"$CAVA_FIFO"

last_quality_check_ms=0
last_file_check_ms=0

while kill -0 "$UXPLAY_PID" 2>/dev/null; do
    handle_keyboard_input
    now_ms="$(get_time_ms)"

    if (( now_ms - last_file_check_ms >= FILE_CHECK_INTERVAL_MS )); then
        art_signature="$(get_file_signature "$ART_FILE")"
        state_signature="$(get_file_signature "$STATE_FILE")"

        if [[ -n "$art_signature" && "$art_signature" != "$LAST_ART_SIGNATURE" ]]; then
            update_accent_from_artwork
            if (( ! MENU_OPEN )); then
                draw_header
                draw_album_art
                draw_metadata
                draw_device
                LAST_RENDERED_PROGRESS_CURRENT=-1
                LAST_RENDERED_PROGRESS_DURATION=-1
                update_progress_display
            fi
            LAST_ART_SIGNATURE="$art_signature"
        fi

        if [[ -n "$meta_signature" && "$meta_signature" != "$LAST_META_SIGNATURE" ]]; then
            update_metadata_cache
            (( MENU_OPEN )) || update_metadata_if_needed
            update_discord_presence_if_needed
            LAST_META_SIGNATURE="$meta_signature"
        fi

        last_file_check_ms="$now_ms"
    fi

    if (( now_ms - last_progress_check_ms >= PROGRESS_INTERVAL_MS )); then
        update_progress_cache
        (( MENU_OPEN )) || update_progress_display
        update_discord_presence_if_needed
        last_progress_check_ms="$now_ms"
    fi

    if (( now_ms - last_quality_check_ms >= QUALITY_INTERVAL_MS )); then
        update_stream_format_cache
        (( MENU_OPEN )) || update_header_if_needed
        update_device_cache
        (( MENU_OPEN )) || update_device_if_needed
        last_quality_check_ms="$now_ms"
    fi

    if IFS= read -r -t 0.02 cava_data <&3; then
        (( MENU_OPEN )) || draw_visualizer_frame "$cava_data"
    fi
done

playback_failed=0
if kill -0 "$UXPLAY_PID" 2>/dev/null &&
   ! kill -0 "$PLAYBACK_PID" 2>/dev/null; then
    playback_failed=1
    kill "$UXPLAY_PID" 2>/dev/null || true
fi

wait "$UXPLAY_PID" 2>/dev/null || true
wait "$PLAYBACK_PID" 2>/dev/null || true

if (( playback_failed )); then
    cleanup
    printf '%s\n' \
        "Uka's playback-state engine stopped unexpectedly." \
        "Diagnostic log: $PLAYBACK_LOG_FILE" >&2
    exit 1
fi
